title: "tap-on-shoulder — PROPOSED workflow (not implemented)" {near: top-center; shape: text; style.font-size: 22}
direction: down

install: "1 · Install (once)" {
  direction: right
  add: "/plugin marketplace add <repo>"
  inst: "/plugin install tap-on-shoulder"
  first: "First hook run:\nfetch classifier bundle\n→ plugin-data\n(SHA-256 verified)"
  fallback: "Offline / failed?\n→ rules-only mode\n(logged, never silent)" {style.stroke-dash: 3}
  add -> inst -> first
  first -> fallback: "on error" {style.stroke-dash: 3}
}

session: "2 · Every Claude Code session (foreground, background, worktree)" {
  claude: "Claude Code session\n(session_id, cwd)" {shape: rectangle}
  hooks: "Plugin hooks\n(hooks/hooks.json)" {
    arm: "ARM events\nStop · StopFailure\nNotification: permission_prompt\nelicitation_dialog"
    disarm: "DISARM events\nUserPromptSubmit · PreToolUse\nSessionStart · SessionEnd"
  }
  claude -> hooks.arm: "turn ends / waits"
  claude -> hooks.disarm: "user replies / work resumes"
}

core: "3 · Deterministic core (no model)" {
  state: "Episode store\nplugin-data/sessions/<session_id>.json\n(episode_id, started_at, trigger, notified)" {shape: cylinder}
  timer: "Detached sleeper\n(one per episode, exits fast hook)"
  check: "Wake after grace (default 300 s):\nsame episode_id? still open?\nnot notified? background_tasks empty?" {shape: diamond}
  drop: "Drop silently\n(stale / resumed)" {style.stroke-dash: 3}
  timer -> check
  check -> drop: "no"
}

classify: "4 · Classifier (local, embedded)" {
  rules: "Event rules first\npermission → needs_permission\nStopFailure → blocked\nAskUserQuestion → needs_decision"
  model: "Static-embedding model\n(model2vec potion + linear head)\nonly if rules undecided\ninput = last_assistant_message (untrusted)"
  out: "Enum label + extractive summary\n(redacted, ≤80 chars)"
  rules -> out: "decided"
  rules -> model: "undecided"
  model -> out
}

policy: "5 · Notification policy" {
  gate: "needs_* / blocked → notify\ndone → only if completion alerts on\ninfo → no alert" {shape: diamond}
}

notify: "6 · Delivery (v0.1)" {
  ntfy: "Plugin connector: ntfy\n(user topic/server, redacted title+summary)\npluggable Notifier interface"
  rc: "Built-in Remote Control push\n(user enables /rc + inputNeededNotifEnabled)\nindependent of plugin, immediate" {style.stroke-dash: 3}
  later: "Later: desktop · Telegram · Slack" {style.stroke-dash: 3}
}

user: "You" {shape: person}

session.hooks.arm -> core.state: "open episode (new episode_id)"
session.hooks.arm -> core.timer: "spawn"
session.hooks.disarm -> core.state: "close episode"
core.state -> core.check: "re-read"
core.check -> classify.rules: "yes"
classify.out -> policy.gate
policy.gate -> notify.ntfy: "send once, mark notified"
notify.ntfy -> user
notify.rc -> user: "" {style.stroke-dash: 3}
user -> session.claude: "responds → DISARM"
