title: "tap-on-shoulder — v0.1 workflow" {near: top-center; shape: text; style.font-size: 22}
direction: down

install: "1 · Install (once)" {
  direction: right
  add: "/plugin marketplace add <repo>"
  inst: "/plugin install tap-on-shoulder"
  first: "First hook run:\nbackground install of the tap binary\n→ plugin-data/bin\n(SHA-256 verified)"
  fallback: "Not installed yet?\n→ no taps, one-line\nSessionStart warning" {style.stroke-dash: 3}
  add -> inst -> first
  first -> fallback: "until done" {style.stroke-dash: 3}
}

session: "2 · Every Claude Code session" {
  claude: "Claude Code session\n(session_id, cwd)" {shape: rectangle}
  hooks: "Plugin hooks → tap hook <Event>\n(hooks/hooks.json, per-session lock)" {
    arm: "OPEN / RE-ARM\nStop (classified) · StopFailure\nPermissionRequest · elicitation_dialog\nPreToolUse: AskUserQuestion / ExitPlanMode"
    disarm: "CLOSE\nUserPromptSubmit · SessionStart · SessionEnd\nPostToolUse of the bound call\nPreToolUse / PostToolUse (unbound)"
  }
  claude -> hooks.arm: "turn ends / waits"
  claude -> hooks.disarm: "user replies / work resumes"
}

classify: "3 · Classifier (in the Stop hook, local)" {
  model: "Embedded model (preview)\nmodel2vec potion-base-8M + linear head\ninput = last_assistant_message (untrusted)"
  out: "Category + extractive summary\n(redacted, ≤80 chars)"
  policy: "done / info with alert off\n→ closed as suppressed" {style.stroke-dash: 3}
  model -> out
  out -> policy: "" {style.stroke-dash: 3}
}

core: "4 · Sweeper (tap sweep, one per machine)" {
  state: "Episode store\nplugin-data/state/<session_id>.json\n(episode id, status, category, due_at)" {shape: cylinder}
  check: "Due (grace, default 300 s)?\nsame episode, still open?\nclaude still running?\npermission tool not running?" {shape: diamond}
  drop: "Close or postpone\n(stale / gone / tool running)" {style.stroke-dash: 3}
  claim: "Claim under lock:\nopen → sending"
  state -> check: "re-read"
  check -> drop: "no"
  check -> claim: "yes"
}

notify: "5 · Delivery" {
  ntfy: "ntfy (your topic/server)\nredacted title + summary\nnotified / failed / sent_uncertain"
  rc: "Built-in Remote Control push\n(user enables /rc + inputNeededNotifEnabled)\nindependent of plugin, immediate" {style.stroke-dash: 3}
}

user: "You" {shape: person}

session.hooks.arm -> classify.model: "Stop"
classify.out -> core.state: "open episode"
session.hooks.arm -> core.state: "open / bind / re-arm"
session.hooks.disarm -> core.state: "close episode"
core.claim -> notify.ntfy: "send at most once"
notify.ntfy -> user
notify.rc -> user: "" {style.stroke-dash: 3}
user -> session.claude: "responds → CLOSE"
